<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.mika.showcase-duna-watch</string>
  <key>ProgramArguments</key>
  <array>
    <string>__DIR__/loop.sh</string>
  </array>
  <key>WorkingDirectory</key><string>__DIR__</string>
  <!-- Proceso vivo que chequea cada 2 min desde adentro. StartInterval no sirve:
       launchd difiere los timers para ahorrar energia (medido: 2m02s y 3m44s).
       KeepAlive lo revive si se cae o si la Mac vuelve de dormir. -->
  <key>KeepAlive</key><true/>
  <key>RunAtLoad</key><true/>
  <key>ThrottleInterval</key><integer>10</integer>
  <key>StandardOutPath</key><string>__DIR__/launchd.out.log</string>
  <key>StandardErrorPath</key><string>__DIR__/launchd.err.log</string>
</dict>
</plist>
