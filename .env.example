# ---------------------------------------------------------------------------
# Copiar a .env y completar. Cada canal se activa SOLO si tiene sus variables.
# Si no configuras ninguno, el script avisa que el mensaje no salio.
# ---------------------------------------------------------------------------

# Canales a usar. Vacio = todos los que tengan credenciales.
# Opciones: telegram,email,whatsapp,sms,macos
CHANNELS=telegram

# --- Telegram (recomendado: gratis, sin dominio, llega al celular) ----------
# 1) Hablar con @BotFather -> /newbot -> copiar el token
# 2) Vos y la otra persona le mandan /start al bot
# 3) curl "https://api.telegram.org/bot<TOKEN>/getUpdates" -> sacar los chat.id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_IDS=

# --- Email (Resend) --------------------------------------------------------
RESEND_API_KEY=
ALERT_EMAILS=persona1@ejemplo.com,persona2@ejemplo.com
MAIL_FROM=Showcase Watch <avisos@TU-DOMINIO-VERIFICADO.com>

# --- WhatsApp (Twilio) -----------------------------------------------------
# OJO: un mensaje no solicitado fuera de la ventana de 24 h necesita plantilla
# aprobada categoria UTILITY. Texto libre rebota.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WA_FROM=+14155238886
ALERT_WHATSAPP=+5491100000000,+5491111111111

# --- SMS (Twilio). Se manda sin tildes ni enie automaticamente. ------------
TWILIO_SMS_FROM=
ALERT_SMS=

# --- Notificacion local del Mac (0 para apagarla) --------------------------
MACOS_NOTIFY=1

# ---------------------------------------------------------------------------
# Ventana de vigilancia
# ---------------------------------------------------------------------------
# Estreno estimado. Si se corre la fecha, mover esto.
RELEASE_DATE=2026-12-14
# Empieza a chequear 80 dias antes -> 2026-09-25
WATCH_DAYS_BEFORE=80
# Cuantos dias seguir mirando DESPUES del estreno (0 = corta el dia del estreno)
WATCH_DAYS_AFTER=0
# Que hacer ANTES de que abra la ventana:
#   off   = no chequea nada (lo pedido)
#   daily = un chequeo por dia como red de seguridad. NO es un aviso por dia:
#           igual solo escribe si encuentra Duna.
PRE_WINDOW_MODE=off

# Aviso "el scraper se rompio" cuando no puede LEER la cartelera 3 veces
# seguidas (no cuando Duna no esta). off = ni eso avisa, silencio total.
WATCHDOG=on

# Que buscar (coma; ignora mayusculas y tildes)
KEYWORDS=duna,dune

# ---------------------------------------------------------------------------
# Estado persistente (solo hace falta en serverless: Vercel / GitHub Actions)
# Sin esto, en serverless el aviso se puede repetir en cada corrida.
# Sirve Vercel KV o Upstash Redis (mismo REST).
# ---------------------------------------------------------------------------
KV_REST_API_URL=
KV_REST_API_TOKEN=
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Protege /api/check en Vercel. Vercel lo manda solo como Bearer en los crons.
CRON_SECRET=
